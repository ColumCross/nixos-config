+void Workspace::setDropPlacement(int x) {
+  const bool dropAfter = x >= m_button.get_allocated_width() / 2;
+  auto context = m_button.get_style_context();
+  m_dropAfter = dropAfter;
+  context->remove_class(dropAfter ? "drop-before" : "drop-after");
+  context->add_class(dropAfter ? "drop-after" : "drop-before");
+}
+void Workspace::clearDropPlacement() {
+  auto context = m_button.get_style_context();
+  context->remove_class("drop-before");
+  context->remove_class("drop-after");
+}
+void Workspace::handleDragBegin(const Glib::RefPtr<Gdk::DragContext>& context) {
+  m_dragWasStarted = true;
+  m_button.get_style_context()->add_class("dragging");
+}
+void Workspace::handleDragEnd(const Glib::RefPtr<Gdk::DragContext>& context) {
+  m_button.get_style_context()->remove_class("dragging");
+  clearDropPlacement();
+}
+bool Workspace::handleDragMotion(const Glib::RefPtr<Gdk::DragContext>& context, int x, int y, guint time) {
+  setDropPlacement(x);
+  context->drag_status(Gdk::ACTION_MOVE, time);
+  return true;
+}
+void Workspace::handleDragLeave(const Glib::RefPtr<Gdk::DragContext>& context, guint time) {
+  clearDropPlacement();
+}
+bool Workspace::handleDragDrop(const Glib::RefPtr<Gdk::DragContext>& context, int x, int y, guint time) {
+  setDropPlacement(x);
+  m_button.drag_get_data(context, "WAYBAR_HYPRLAND_WORKSPACE", time);
+  return true;
+}
+void Workspace::handleDragDataGet(const Glib::RefPtr<Gdk::DragContext>& context, Gtk::SelectionData& selection_data, guint info, guint time) {
+  selection_data.set("WAYBAR_HYPRLAND_WORKSPACE", std::to_string(id()));
+}
+void Workspace::handleDragDataReceived(const Glib::RefPtr<Gdk::DragContext>& context, int x, int y, const Gtk::SelectionData& selection_data, guint info, guint time) {
+  clearDropPlacement();
+  bool success = false;
+  try {
+    const std::string sourceText = selection_data.get_data_as_string();
+    size_t parsed = 0;
+    const int sourceId = std::stoi(sourceText, &parsed);
+    if (sourceText.empty() || parsed != sourceText.size()) {
+      throw std::invalid_argument("workspace ID contains invalid data");
+    }
+    if (sourceId == id()) {
+      success = true;
+    } else {
+      std::string command = m_workspaceManager.onWorkspaceDrop();
+      command = std::regex_replace(command, std::regex("\\{source\\}"), std::to_string(sourceId));
+      command = std::regex_replace(command, std::regex("\\{target\\}"), std::to_string(id()));
+      command = std::regex_replace(command, std::regex("\\{placement\\}"), m_dropAfter ? "after" : "before");
+      success = util::command::execNoRead(command).exit_code == 0;
+    }
+  } catch (const std::exception& error) {
+    spdlog::error("Invalid workspace drag data: {}", error.what());
+  }
+  context->drag_finish(success, false, time);
+}
