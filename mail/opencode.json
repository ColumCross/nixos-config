{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "email",
  "share": "disabled",
  "snapshot": false,
  "lsp": false,
  "formatter": false,
  "permission": {
    "*": "deny"
  },
  "agent": {
    "email": {
      "mode": "primary",
      "description": "Searches, reads, summarizes, classifies, and drafts replies from configured local mail only.",
      "permission": {
        "*": "deny",
        "mail_search": "allow",
        "mail_read": "allow",
        "mail_thread": "allow",
        "mail_status": "allow",
        "mail_save_note": "allow"
      }
    }
  }
}
