{
  dark = ''
    [global]
    frame_color = "#3b4252"

    [urgency_low]
    background = "#3b4252"
    foreground = "#d8dee9"

    [urgency_normal]
    background = "#434c5e"
    foreground = "#eceff4"

    [urgency_critical]
    background = "#bf616a"
    foreground = "#eceff4"
  '';

  light = ''
    [global]
    frame_color = "#d8dee9"

    [urgency_low]
    background = "#d8dee9"
    foreground = "#2e3440"

    [urgency_normal]
    background = "#e5e9f0"
    foreground = "#2e3440"

    [urgency_critical]
    background = "#bf616a"
    foreground = "#eceff4"
  '';
}
